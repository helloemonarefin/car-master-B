---
/**
 * Footer — DESIGN_SYSTEM §6 + Figma "Footer" (24:934); skeleton BOILERPLATE §2.4.
 * --bg-tertiary, top border subtle, padding 96/64/40, row gap 72.
 * Top row: brand (logo + tagline, gap 20) + links. Then 4 info columns
 * (label + .t-body-sm in --text-nav, gap 10). Then the .t-wordmark.
 * Then the bottom bar (top border, padding-top 24, .t-small tertiary).
 * All client facts come from site.ts.
 */
import Logo from '../ui/Logo.astro';
import { footer } from '../../content/layout';
import { site } from '../../content/site';

const year = new Date().getFullYear();
const cityLine = [site.city, site.region].filter(Boolean).join(', ');

const info = [
  { label: footer.infoLabels.studio, lines: site.address },
  { label: footer.infoLabels.contact, lines: [site.phone, site.email].filter(Boolean), contact: true },
  { label: footer.infoLabels.hours, lines: site.hours },
  { label: footer.infoLabels.serving, lines: site.serviceArea.length ? [site.serviceArea.join(' · ')] : [] },
].filter((c) => c.lines.length > 0);
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__top">
      <div class="footer__brand">
        <Logo href="/" />
        {site.tagline && <p class="t-small footer__tagline">{site.tagline}</p>}
      </div>
      <nav aria-label="Footer">
        <ul role="list" class="footer__links">
          {footer.links.map((l) => (
            <li>
              {l.href ? (
                <a class="footer__link t-small-strong" href={l.href}>{l.label}</a>
              ) : (
                <span class="footer__link t-small-strong">{l.label}</span>
              )}
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <dl class="footer__info">
      {info.map((col) => (
        <div class="footer__col">
          <dt class="t-label footer__label">{col.label}</dt>
          <dd class="t-body-sm footer__value">
            {col.contact ? (
              <>
                {site.phone && <a class="footer__link" href={site.phoneHref}>{site.phone}</a>}
                {site.email && <a class="footer__link" href={`mailto:${site.email}`}>{site.email}</a>}
              </>
            ) : (
              col.lines.map((line) => <span>{line}</span>)
            )}
          </dd>
        </div>
      ))}
    </dl>

    <p class="t-wordmark footer__wordmark">{site.businessName}</p>

    <div class="footer__bottom t-small">
      <p>© {year} {site.businessName}</p>
      <p class="footer__location">
        {cityLine && <span>{cityLine}</span>}
        {cityLine && site.phone && <span aria-hidden="true">·</span>}
        {site.phone && <a class="footer__bottom-link" href={site.phoneHref}>{site.phone}</a>}
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: var(--z-section);
    background: var(--bg-tertiary);
    border-top: var(--border-width) solid var(--border-subtle);
    padding-top: var(--footer-pad-top);
    padding-bottom: var(--footer-pad-bottom);
  }
  .footer__inner {
    display: flex;
    flex-direction: column;
    gap: var(--footer-gap);
  }

  /* ---------- Top row ---------- */
  .footer__top {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
  .footer__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--footer-brand-gap);
  }
  .footer__tagline { color: var(--text-secondary); }
  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
  }
  .footer__link {
    color: var(--text-nav);
    transition: color var(--dur-fast) var(--ease-color);
  }
  a.footer__link:focus-visible { color: var(--text-primary); }

  /* ---------- Info columns: 1 col < 480 (email fits), 2 × 2 to 1024, 4 across above ---------- */
  .footer__info {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8) var(--grid-gutter);
  }
  @media (min-width: 480px) {
    .footer__info { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  .footer__col {
    display: flex;
    flex-direction: column;
    gap: var(--footer-info-gap);
  }
  .footer__label { color: var(--text-tertiary); }
  .footer__value {
    display: flex;
    flex-direction: column;
    margin: 0;
    color: var(--text-nav);
    overflow-wrap: anywhere;
  }

  /* ---------- Wordmark ---------- */
  .footer__wordmark { color: var(--text-primary); }

  /* ---------- Bottom bar ---------- */
  .footer__bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-6);
    border-top: var(--border-width) solid var(--border-subtle);
    color: var(--text-tertiary);
  }
  .footer__location { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .footer__bottom-link { transition: color var(--dur-fast) var(--ease-color); }
  .footer__bottom-link:focus-visible { color: var(--text-primary); }

  @media (hover: hover) and (pointer: fine) {
    a.footer__link:hover,
    .footer__bottom-link:hover { color: var(--text-primary); }
  }

  @media (min-width: 1024px) {
    .footer__top {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
    }
    .footer__brand {
      width: calc((100% - 11 * var(--grid-gutter)) / 12 * 4 + 3 * var(--grid-gutter)); /* 4 columns = 416 */
    }
    .footer__links { flex-wrap: nowrap; gap: var(--space-8); }
    .footer__info { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .footer__bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
    }
  }
</style>
