---
/**
 * FAQ item — DESIGN_SYSTEM §6, Figma "FAQ item" (24:888).
 * Padding 28/0, top border subtle (list adds the last bottom border).
 * Question row: .t-h5 text + 24px plus/minus icon, gap 24. Answer (.t-body-lg
 * secondary, max 600) opens below with gap 14.
 * Behaviour: a real <button aria-expanded> controls a region. Phase 3 = instant
 * open/close; the animated-height version is proposed in Phase 5.
 */
import Icon from './Icon.astro';
import type { FaqItem } from '../../content/types';

interface Props { item: FaqItem; id: string; open?: boolean }
const { item, id, open = false } = Astro.props;
const qId = `${id}-q`;
const aId = `${id}-a`;
---

<li class="faq-item" data-faq-item data-reveal>
  <h3 class="faq-item__heading">
    <button
      class="faq-item__q t-h5"
      type="button"
      id={qId}
      aria-expanded={open ? 'true' : 'false'}
      aria-controls={aId}
      data-faq-toggle
    >
      <span class="faq-item__q-text">{item.question}</span>
      <span class="faq-item__icon" aria-hidden="true">
        <Icon name="plus" class="faq-item__plus" />
        <Icon name="minus" class="faq-item__minus" />
      </span>
    </button>
  </h3>
  <div class="faq-item__a" id={aId} role="region" aria-labelledby={qId} hidden={!open}>
    <p class="t-body-lg faq-item__a-text">{item.answer}</p>
  </div>
</li>

<style>
  .faq-item {
    padding-block: var(--space-7);
    border-top: var(--border-width) solid var(--border-subtle);
  }
  .faq-item:last-child { border-bottom: var(--border-width) solid var(--border-subtle); }
  .faq-item__heading { font: inherit; }

  .faq-item__q {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    width: 100%;
    text-align: left;
    color: var(--text-primary);
    -webkit-tap-highlight-color: transparent;
  }
  .faq-item__q-text { flex: 1; min-width: 0; }
  .faq-item__icon { display: grid; flex: none; }
  .faq-item__icon > :global(svg) { grid-area: 1 / 1; }
  .faq-item__q[aria-expanded='true'] :global(.faq-item__plus),
  .faq-item__q[aria-expanded='false'] :global(.faq-item__minus) { visibility: hidden; }

  .faq-item__a { padding-top: var(--faq-answer-gap); }
  .faq-item__a-text { max-width: var(--faq-answer-max); color: var(--text-secondary); }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-faq-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const panel = document.getElementById(btn.getAttribute('aria-controls') ?? '');
      if (!panel) return;
      const open = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
    });
  });
</script>
