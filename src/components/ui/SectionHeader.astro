---
/**
 * Section header — DESIGN_SYSTEM §6, Figma "Section header".
 * Index in cols 1–4, title column in cols 6–12: h2 (.t-h2) + optional
 * intro (.t-body-lg, secondary), gap 24. Stacks below 1024 (gap 20).
 */
import SectionIndex from './SectionIndex.astro';
import Split from '../layout/Split.astro';

interface Props {
  index: number;
  /** Index label, e.g. "The Signature Program". ≤ 28 chars. */
  label: string;
  /** h2. ≤ 2 lines in 752px, ~40 chars. */
  title: string;
  /** id for the section's aria-labelledby. */
  id: string;
  /** ≤ 3 lines, ~220 chars. */
  intro?: string;
  class?: string;
}

const { index, label, title, id, intro, class: className } = Astro.props;
---

<Split class:list={['section-header', className]}>
  <SectionIndex slot="aside" index={index} label={label} />
  <div class="section-header__main">
    <h2 id={id} class="t-h2">{title}</h2>
    {intro && <p class="t-body-lg section-header__intro">{intro}</p>}
  </div>
</Split>

<style>
  .section-header__main {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .section-header__intro { color: var(--text-secondary); }
  :global(.section--inverse) .section-header__intro { color: var(--text-on-dark-secondary); }
</style>
