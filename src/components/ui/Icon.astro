---
/**
 * Icon — BOILERPLATE §2.13. Inline SVG from a typed map, drawn in
 * currentColor with the --icon-stroke token. Paths copied from Figma
 * (Master B › Icon / arrowR, Icon / arrowUR). Decorative by default.
 */
const icons = {
  'arrow-right': {
    size: 18,
    body: '<path d="M3 9H15"/><path d="M10.5 4.5L15 9L10.5 13.5"/>',
  },
  'arrow-up-right': {
    size: 16,
    body: '<path d="M4.66667 11.3333L11.3333 4.66667"/><path d="M5.33333 4.66667H11.3333V10.6667"/>',
  },
  // Filled shape (Figma "Stars" › #accent): drawn with fill, not stroke.
  star: {
    size: 16,
    filled: true,
    body: '<path d="M8 0L10.163 5.02282L15.6085 5.52786L11.4999 9.13718L12.7023 14.4721L8 11.68L3.29772 14.4721L4.50011 9.13718L0.391548 5.52786L5.83695 5.02282L8 0Z"/>',
  },
} as const satisfies Record<string, { size: number; body: string; filled?: boolean }>;

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  /** Rendered size in px; defaults to the Figma size of the icon. */
  size?: number;
  class?: string;
  /** Give a label only when the icon stands alone. */
  label?: string;
}

const { name, size, class: className, label } = Astro.props;
const icon: { size: number; body: string; filled?: boolean } = icons[name];
const px = size ?? icon.size;
---

<svg
  class:list={['icon', className]}
  width={px}
  height={px}
  viewBox={`0 0 ${icon.size} ${icon.size}`}
  fill={icon.filled ? 'currentColor' : 'none'}
  stroke={icon.filled ? 'none' : 'currentColor'}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={icon.body}
/>

<style>
  .icon {
    flex: none;
    stroke-width: var(--icon-stroke);
  }
</style>
