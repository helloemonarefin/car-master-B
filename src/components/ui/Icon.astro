---
/**
 * Icon — BOILERPLATE §2.13. Inline SVG from a typed map, drawn in
 * currentColor with the --icon-stroke token. Paths copied from Figma
 * (Master B › Icon / arrowR, Icon / arrowUR). Decorative by default.
 */
const icons = {
  'arrow-right': {
    size: 18,
    body: '<path d="M3 9H15"/><path d="M10.5 4.5L15 9L10.5 13.5"/>',
  },
  'arrow-up-right': {
    size: 16,
    body: '<path d="M4.66667 11.3333L11.3333 4.66667"/><path d="M5.33333 4.66667H11.3333V10.6667"/>',
  },
  phone: {
    size: 18,
    body: '<path d="M16.5 12.69V14.94C16.5008 15.1489 16.4581 15.3556 16.3744 15.547C16.2907 15.7384 16.168 15.9102 16.0141 16.0514C15.8601 16.1926 15.6784 16.3001 15.4806 16.367C15.2827 16.4339 15.073 16.4588 14.865 16.44C12.5571 16.1892 10.3402 15.4006 8.3925 14.1375C6.58037 12.986 5.044 11.4496 3.8925 9.6375C2.62498 7.6809 1.83618 5.45325 1.59 3.135C1.57126 2.9276 1.59591 2.71857 1.66238 2.52122C1.72884 2.32387 1.83568 2.14252 1.97607 1.98872C2.11647 1.83491 2.28735 1.71203 2.47784 1.62789C2.66833 1.54375 2.87426 1.5002 3.0825 1.5H5.3325C5.69648 1.49642 6.04934 1.62531 6.32532 1.86265C6.6013 2.09999 6.78156 2.42958 6.8325 2.79C6.92747 3.51005 7.10359 4.21705 7.3575 4.8975C7.45841 5.16594 7.48025 5.45769 7.42043 5.73816C7.36061 6.01863 7.22165 6.27608 7.02 6.48L6.0675 7.4325C7.13517 9.31016 8.68984 10.8648 10.5675 11.9325L11.52 10.98C11.7239 10.7784 11.9814 10.6394 12.2618 10.5796C12.5423 10.5198 12.8341 10.5416 13.1025 10.6425C13.783 10.8964 14.49 11.0725 15.21 11.1675C15.5743 11.2189 15.9071 11.4024 16.1449 11.6831C16.3827 11.9638 16.5091 12.3222 16.5 12.69Z"/>',
  },
  plus: {
    size: 24,
    body: '<path d="M12 5V19"/><path d="M5 12H19"/>',
  },
  minus: {
    size: 24,
    body: '<path d="M5 12H19"/>',
  },
  // Filled shape (Figma "Stars" › #accent): drawn with fill, not stroke.
  star: {
    size: 16,
    filled: true,
    body: '<path d="M8 0L10.163 5.02282L15.6085 5.52786L11.4999 9.13718L12.7023 14.4721L8 11.68L3.29772 14.4721L4.50011 9.13718L0.391548 5.52786L5.83695 5.02282L8 0Z"/>',
  },
} as const satisfies Record<string, { size: number; body: string; filled?: boolean }>;

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  /** Rendered size in px; defaults to the Figma size of the icon. */
  size?: number;
  class?: string;
  /** Give a label only when the icon stands alone. */
  label?: string;
}

const { name, size, class: className, label } = Astro.props;
const icon: { size: number; body: string; filled?: boolean } = icons[name];
const px = size ?? icon.size;
---

<svg
  class:list={['icon', className]}
  width={px}
  height={px}
  viewBox={`0 0 ${icon.size} ${icon.size}`}
  fill={icon.filled ? 'currentColor' : 'none'}
  stroke={icon.filled ? 'none' : 'currentColor'}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={icon.body}
/>

<style>
  .icon {
    flex: none;
    stroke-width: var(--icon-stroke);
  }
</style>
