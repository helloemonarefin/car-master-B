---
/**
 * Renders a page's section array in order. Maps each `type` to its
 * component and passes the generated index number. Add new section
 * types here as they are built.
 */
import Hero from './Hero.astro';
import Problem from './Problem.astro';
import Services from './Services.astro';
import Signature from './Signature.astro';
import Guarantee from './Guarantee.astro';
import Process from './Process.astro';
import Portfolio from './Portfolio.astro';
import Why from './Why.astro';
import Testimonial from './Testimonial.astro';
import Faq from './Faq.astro';
import FinalCta from './FinalCta.astro';
import { numberSections } from '../../lib/sections';
import type { SectionContent } from '../../content/types';

interface Props { sections: SectionContent[] }
const items = numberSections(Astro.props.sections);
---

{items.map(({ content, index }) => {
  switch (content.type) {
    case 'hero': return <Hero content={content} />;
    case 'problem': return <Problem content={content} index={index} />;
    case 'services': return <Services content={content} index={index} />;
    case 'signature': return <Signature content={content} index={index} />;
    case 'guarantee': return <Guarantee content={content} index={index} />;
    case 'process': return <Process content={content} index={index} />;
    case 'portfolio': return <Portfolio content={content} index={index} />;
    case 'why': return <Why content={content} index={index} />;
    case 'testimonial': return <Testimonial content={content} index={index} />;
    case 'faq': return <Faq content={content} index={index} />;
    case 'final-cta': return <FinalCta content={content} />;
  }
})}
